{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.3.0",
  "description": "__MSG_extensionDescription__",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "128": "assets/icon-128.png"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.binance.com/*",
        "https://binance.com/*"
      ],
      "js": [
        "src/storage.js",
        "src/locales/en.js",
        "src/i18n.js",
        "src/core.js",
        "src/workspace.js",
        "src/market.js",
        "src/price-effects.js",
        "src/controls.js",
        "src/cockpit.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src wss://fstream.binance.com wss://stream.binance.com:9443"
  },
  "default_locale": "en"
}
