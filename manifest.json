{
  "manifest_version": 3,
  "name": "Binance Studio · 币安主题与布局",
  "version": "0.2.0",
  "description": "用空间布局编辑器、边缘 Dock、聚光灯、交易对房间、风格皮肤和动态盘口，打造自己的币安交易驾驶舱。",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "activeTab"],
  "background": { "service_worker": "src/background.js" },
  "action": {
    "default_title": "Binance Studio",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "128": "assets/icon-128.png"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://www.binance.com/*", "https://binance.com/*"],
      "js": [
        "src/core.js",
        "src/workspace.js",
        "src/market.js",
        "src/cockpit.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src wss://fstream.binance.com wss://stream.binance.com:9443"
  }
}
