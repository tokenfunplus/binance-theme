{
  "name": "binance-studio",
  "version": "0.3.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Local-first Binance theme and layout browser extension",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/italic-jinxin/binance-theme.git"
  },
  "bugs": {
    "url": "https://github.com/italic-jinxin/binance-theme/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/serve.cjs",
    "check": "node scripts/check.cjs",
    "test": "node --test tests/*.test.cjs",
    "build": "node scripts/build.cjs",
    "test:browser": "node tests/browser.cjs && node tests/cockpit-browser.cjs && node tests/price-browser.cjs && node tests/i18n-browser.cjs && node tests/controls-browser.cjs",
    "test:controls": "node tests/controls-browser.cjs",
    "test:i18n": "node tests/i18n-browser.cjs",
    "test:prices": "node tests/price-browser.cjs",
    "test:cockpit": "node tests/cockpit-browser.cjs"
  },
  "devDependencies": {
    "playwright": "^1.56.1"
  }
}
